# Copia este archivo a .env.local para desarrollo local.
# En producción (Vercel), estas mismas variables se configuran en
# Project Settings → Environment Variables — nunca se suben al repo.

# Contraseña compartida que escribe el equipo para entrar al panel.
DASHBOARD_PASSWORD=

# Secreto aleatorio propio (no la contraseña de arriba) usado para firmar la
# cookie de sesión. Generar uno con: openssl rand -hex 32
SESSION_SECRET=

# Proyecto y dataset de BigQuery donde vive la base de Otoch Colibrí.
BIGQUERY_PROJECT_ID=bases-de-datos-sheets
BIGQUERY_DATASET=Clientes_Admin_Tucan

# JSON completo (en una sola línea) de la cuenta de servicio de Google Cloud
# con permiso de lectura (BigQuery Data Viewer + BigQuery Job User) sobre
# ese dataset. Se pega tal cual, entre comillas simples si usas un .env.local.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
